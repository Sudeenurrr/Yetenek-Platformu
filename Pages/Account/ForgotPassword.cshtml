@page
@model YetenekPlatformu.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
}

@* Stiller: wwwroot/css/site.css -> "Hesap formları" *@
<div class="account-card">
    <h1 class="account-title">Şifremi Unuttum</h1>
    <p>Kayıt olurken size verilen kurtarma koduyla yeni bir şifre belirleyebilirsiniz.</p>

    <form method="post" novalidate class="account-form" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Input.FirstName" class="form-label">Ad</label>
            <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" />
            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.LastName" class="form-label">Soyad</label>
            <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" />
            <span asp-validation-for="Input.LastName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.RecoveryCode" class="form-label">Kurtarma Kodu <span class="field-hint">ör. K7MP-X3QR-9HTW</span></label>
            <input asp-for="Input.RecoveryCode" class="form-control" maxlength="20" autocomplete="off" spellcheck="false" />
            <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.NewPassword" class="form-label">Yeni Şifre <span class="field-hint">en az 6 karakter</span></label>
            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="fancy-btn fancy-btn-primary">Şifremi Sıfırla</button>
            <span class="form-alt">
                <span class="form-alt-text">Şifrenizi hatırladınız mı?</span>
                <a class="fancy-btn fancy-btn-secondary" asp-page="/Account/Login">Giriş Yap</a>
            </span>
        </div>
    </form>
</div>
