{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Scheduling": {
    "DayStartHour": 9,
    "DayEndHour": 21,
    "MaxDaysAhead": 30,
    "StatusUpdateIntervalSeconds": 60
  },
  "Nominatim": {
    "BaseUrl": "https://nominatim.openstreetmap.org/",
    "UserAgent": "YetenekPlatformu/1.0",
    "MinIntervalMilliseconds": 1100,
    "MaxQueueWaitMilliseconds": 4000,
    "TimeoutSeconds": 5,
    "CacheHours": 24
  }
}
